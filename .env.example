# ------------------------------------------------------------------ #
#  Environment variables. Copy to `.env` and fill in your values.     #
#  The site renders with fallback content until DATABASE_URL is set.  #
# ------------------------------------------------------------------ #

# --- Database (Neon Postgres) -------------------------------------- #
# Create a free project at https://neon.tech. DATABASE_URL is the pooled
# connection string (used by the app at runtime); DIRECT_URL is the
# non-pooled one (used by Prisma Migrate — Neon's pooler doesn't support
# the advisory locks migrations rely on).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js (admin sign-in) --------------------------------------- #
# Generate a secret with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# GitHub OAuth app (Settings → Developer settings → OAuth Apps).
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Only this GitHub account can access /admin. The numeric id is authoritative
# (usernames can be renamed/released); the login is an extra sanity check.
ADMIN_GITHUB_LOGIN="ARKhan8604"
ADMIN_GITHUB_ID="177038875"

# --- Cloudinary (image & file uploads) ----------------------------- #
# From your Cloudinary dashboard.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- GitHub Activity (optional) ------------------------------------ #
# A classic/fine-grained PAT with read-only access enables the live
# contribution calendar. Without it, repos + languages still show.
GITHUB_TOKEN=""

# --- Analytics (PostHog) ------------------------------------------- #
# Project token from Project Settings → the ingest host (not the app host).
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Site ---------------------------------------------------------- #
# Used for absolute URLs (metadata, sitemap, OG images).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
